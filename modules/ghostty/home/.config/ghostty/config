theme = workstation
# A new window's first frame is drawn by GTK before the terminal is ready.
# Opaque and in the terminal's colors, it matches what follows; translucent,
# it flashes the wallpaper. Inactive windows still get glass from Hyprland.
window-theme = ghostty
cursor-style = block
font-family = FiraCode Nerd Font
font-size = 12
window-padding-x = 8
window-padding-y = 8
window-decoration = false
confirm-close-surface = false
resize-overlay = never

# Background instance (systemd unit) makes new windows instant; keep it alive.
gtk-single-instance = true
quit-after-last-window-closed = false

# no-cursor: shell integration would turn the block into a bar at the prompt.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
gtk-custom-css = style.css

# New window in the same directory; Hyprland tiles it like a split.
keybind = ctrl+shift+enter=new_window

# Ctrl+C copies when there's a selection, otherwise interrupts.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+shift+c=text:\x03
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+backspace=text:\x1b\x7f
# Ctrl+A then Backspace or Delete clears the line, like select-all + delete.
keybind = ctrl+a>backspace=text:\x15
keybind = ctrl+a>delete=text:\x15
keybind = ctrl+p=text:\x14
